# Copy to .env. Defaults are validated at startup.
# Any host other than 127.0.0.1/::1/localhost requires API_KEY; the service refuses to start without it.
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
LOG_JSON=false
# Set a secret before exposing /crawl, /crawl/batch or /stats publicly. It also hides /docs and /openapi.json.
API_KEY=
# Request bodies above this size are rejected with 413 before authentication.
MAX_REQUEST_BYTES=1048576
# Crawl requests per second after authentication (0 = off); each URL costs one token.
INBOUND_RATE_LIMIT_RPS=0
INBOUND_RATE_LIMIT_BURST=20

DEFAULT_MODE=auto
DEFAULT_TIMEOUT_SECONDS=120
DEFAULT_RETRIES=1
DEFAULT_MAX_BYTES=10485760
# Defaults to WebsiteTextExtraction/<version> (+project URL). Keep a contact URL in your own
# value: sites with a bot policy block anonymous crawlers (Wikimedia answers 403).
# DEFAULT_USER_AGENT=
# Accept-Language for every crawl unless a request sets one; empty sends none. Example: de,en;q=0.8
DEFAULT_ACCEPT_LANGUAGE=
# Check robots.txt before each crawl unless a request says otherwise (RFC 9309).
RESPECT_ROBOTS_TXT=false
DEFAULT_HEADLESS=true
DEFAULT_JS_STRATEGY=speed
DEFAULT_JS_AUTO_WAIT=true
HTML_CONVERTER=trafilatura
TRAFILATURA_CLEAN_MARKDOWN=true
MEDIA_CONVERSION_POLICY=skip
ALLOW_INSECURE_SSL=false
SSRF_PROTECTION=true

# Capacities are per Uvicorn process. Default: no Chrome processes at startup.
UVICORN_WORKERS=1
MAX_CONCURRENT_REQUESTS=8
MAX_QUEUE_SIZE=50
QUEUE_TIMEOUT_SECONDS=60
# Background jobs (POST /jobs): unfinished jobs per process, and how long results stay readable.
MAX_ACTIVE_JOBS=10
JOB_RESULT_TTL=3600
HTTP_MAX_CONNECTIONS=16
SELENIUM_MAX_POOL_SIZE=2
CONVERSION_WORKERS=2
# Each worker process is replaced after this many successful jobs (bounds memory growth).
WORKER_MAX_JOBS=100
# Empty paths use Selenium Manager. Preinstall a compatible Chrome/driver for production.
CHROME_BINARY=
CHROMEDRIVER_PATH=
# Explicit development opt-in only, e.g. a root-owned Colab runtime.
SELENIUM_NO_SANDBOX=false

# Shared on one machine; use the same private local directory for all Uvicorn workers.
# Empty = $XDG_CACHE_HOME/website-text-extraction or ~/.cache/website-text-extraction.
RESULT_CACHE_DIR=
RESULT_CACHE_TTL=300
RESULT_CACHE_MAX_SIZE=200
# Seconds an HTTP result stays available for a conditional request (ETag/Last-Modified); 0 = off.
REVALIDATION_TTL=86400
# Document attempts per second (HTTP retries/redirects + browser initial navigation/retries).
# Browser assets and its internal redirects are not counted as separate attempts.
GLOBAL_RATE_LIMIT_RPS=0
# Above 0 this is a ceiling; requests can only lower it.
DEFAULT_DOMAIN_RATE_LIMIT_RPS=0

# Optional: pip install -e '.[pii]' and install only the language models you need.
PRESIDIO_DE_MODEL=de_core_news_lg
PRESIDIO_EN_MODEL=en_core_web_lg
