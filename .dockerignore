# Keep secrets out of the build context. An .env copied into a layer stays in
# the image even if a later layer deletes it.
.env
.env.local
*.pem
*.key

# Version control and local tooling
.git
.github
.gitignore
.claude
.vscode
.idea

# Local environments and caches - large, and built for the host's platform
.venv
venv
ENV
env
__pycache__
*.py[cod]
.mypy_cache
.pytest_cache
.ruff_cache
htmlcov
.coverage
.coverage.*

# Build output; the image installs from the source tree
dist
build
*.egg-info

# Not needed at runtime
tests
docs
deploy
helper
*.ipynb
*.md
!README.md

# Lock files of package managers the project does not use
uv.lock
poetry.lock
Pipfile.lock

# Drivers downloaded for the host platform
chromedriver*
geckodriver*
*.log
